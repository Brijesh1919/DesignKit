{
  "name": "designkit",
  "version": "1.0.0",
  "type": "module",
  "description": "All-in-one local Figma design utility toolkit",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate_u2netp.mjs",
    "test:responsive": "npx tsx scripts/test_responsive_engine.mjs",
    "test": "node scripts/verify_e2e.mjs && npx tsx scripts/test_responsive_engine.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0",
    "pako": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.91.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.20.1",
    "onnxruntime-node": "^1.29.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
